2 guests per occupied room","Breakfast: 68% of guests at €14.50","Restaurant: 41% in-house capture plus 26–42 external covers at €38.00","Bar: €9.50 per occupied room","Spa: 16% capture plus 6 external treatments at €82.00","Other: parking 24% at €24.00, minibar and laundry €4.20 per occupied room, meeting space Tuesday to Thursday"]},"total_revenue":{"id":"total_revenue","name":"Total Hotel Revenue","shortName":"Total revenue","value":"€15,091","period":"Tonight · Thursday 15 January 2026","definition":"Every department the demo hotel operates, added up for tonight.","formula":"Sum of included departmental revenue","inputs":[{"label":"Rooms","value":"€8,932.50","origin":"CALCULATED"},{"label":"Food & beverage","value":"€3,917.13","origin":"ASSUMPTION"},{"label":"Spa & wellness","value":"€1,213.60","origin":"ASSUMPTION"},{"label":"Other services","value":"€1,027.80","origin":"ASSUMPTION"}],"source":"$19:props:children:props:evidence:occupancy_rate:source","assumptions":"$19:props:children:props:evidence:trevpar:assumptions"},"room_revenue":{"id":"room_revenue","name":"Room Revenue","shortName":"Room revenue","value":"€8,933","period":"Tonight · Thursday 15 January 2026","definition":"What the bedrooms bring in tonight.","formula":"Sum of revenue mapped to the rooms department","inputs":[{"label":"Standard · 25 rooms at €132.00","value":"€3,300.00","origin":"CALCULATED"},{"label":"Deluxe · 21 rooms at €157.00","value":"€3,297.00","origin":"CALCULATED"},{"label":"Suite · 9 rooms at €259.50","value":"€2,335.50","origin":"CALCULATED"}],"source":"$19:props:children:props:evidence:occupancy_rate:source","assumptions":[]},"revpor":{"id":"revpor","name":"Revenue per Occupied Room","shortName":"RevPOR","value":"€274.38","period":"Tonight · Thursday 15 January 2026","definition":"What an occupied room is worth across the whole hotel, bedroom and everything else.","formula":"Declared Revenue / Occupied Rooms","inputs":[{"label":"Total revenue","value":"€15,091.03","origin":"CA